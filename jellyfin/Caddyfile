# Gateway for https://videos.yajur.ai (cloudflared → gateway:80)
#   /kodai1994/       Kodai 1994 collection page (static; signs in against Jellyfin)
#   /kodai1994/hls/   the collection's HLS streams, thumbnails, and backdrop: members only
#   /kodai1994/faces/ face crops for the Identify page: members only
#   /kodai1994/memories/ PDFs attached to memories: members only
#   /                 redirects to the collection
#   everything else → Jellyfin API (sign-in, listings, progress), minus playback/download
#
# `route` keeps the blocks below in the order written (Caddy would otherwise sort them).

{
	admin off
	auto_https off
}

:80 {
	route {
		# Unlisted: links are shared privately, so nothing on this host may be indexed.
		header X-Robots-Tag "noindex, nofollow, noarchive"
		handle /robots.txt {
			respond "User-agent: *
Disallow: /
" 200
		}

		# No public playback or download through Jellyfin. Its stream endpoints hand out
		# the whole file (and are anonymous in 12.2, by guessable item ID); members watch
		# the HLS copies below instead. Its web UI is for the admin, on 127.0.0.1:8099.
		# Case-insensitive because Jellyfin's routes are.
		@blocked path_regexp blocked (?i)^/+(videos|audio|livetv|web)(/|$)|^/+items/[^/]+/(download|file)(/|$)
		handle @blocked {
			respond 404
		}

		redir / /kodai1994/ 302
		redir /kodai1994 /kodai1994/ 308

		# HLS playlists/segments, thumbnails, and the backdrop photo. A request passes only
		# if the kodai_auth cookie (set by the page at sign-in, scoped to this path) holds
		# a Jellyfin token whose user can see the Kodai 1994 library: GET /Items/<library>
		# answers 200 for such a user, 404 for other users, 401 for bad tokens.
		# no-store keeps Cloudflare (and browsers) from caching members-only bytes.
		handle_path /kodai1994/hls/* {
			forward_auth jellyfin:8096 {
				uri /Items/{$KODAI_LIBRARY_ID}
				header_up Authorization `MediaBrowser Token="{http.request.cookie.kodai_auth}"`
			}
			header Cache-Control "private, no-store"
			root * /srv/kodai1994-hls
			file_server
		}

		# Face crops for the Identify page (faceid worker output): members only, as above.
		handle_path /kodai1994/faces/* {
			forward_auth jellyfin:8096 {
				uri /Items/{$KODAI_LIBRARY_ID}
				header_up Authorization `MediaBrowser Token="{http.request.cookie.kodai_auth}"`
			}
			header Cache-Control "private, no-store"
			root * /srv/kodai1994-faces
			file_server
		}

		# PDFs attached to memories (notes members shared): members only. sandbox: opened on
		# their own, they can't run scripts or reach the page; the site previews them with PDF.js.
		handle_path /kodai1994/memories/* {
			forward_auth jellyfin:8096 {
				uri /Items/{$KODAI_LIBRARY_ID}
				header_up Authorization `MediaBrowser Token="{http.request.cookie.kodai_auth}"`
			}
			header {
				Cache-Control "private, no-store"
				Content-Security-Policy "sandbox"
				X-Content-Type-Options "nosniff"
			}
			root * /srv/kodai1994-memories
			file_server
		}

		# Community API (kodai1994/community/app.py): comments, display names, access requests.
		# The member's token goes to the service as X-Kodai-Token, taken from the cookie and
		# overwriting anything the browser sent; the service checks it with Jellyfin itself.
		# Only the access-request form is open to visitors who aren't signed in.
		handle /kodai1994/api/access-requests {
			uri strip_prefix /kodai1994/api
			reverse_proxy community:8000 {
				header_up -X-Kodai-Token
				header_up X-Client-IP {http.request.header.Cf-Connecting-IP}
			}
		}
		handle_path /kodai1994/api/* {
			reverse_proxy community:8000 {
				header_up X-Kodai-Token {http.request.cookie.kodai_auth}
				header_up X-Client-IP {http.request.header.Cf-Connecting-IP}
			}
		}

		# Logo and favicon: public, because the sign-in page shows them. Kept out of the
		# repository (third-party emblem), in MEDIA_DIR/kodai1994-brand.
		handle_path /kodai1994/brand/* {
			header Cache-Control "public, max-age=86400"
			root * /srv/kodai1994-brand
			file_server
		}

		handle_path /kodai1994/* {
			root * /srv/kodai1994
			file_server
			header {
				Cache-Control "no-cache"
				X-Frame-Options "DENY"
				X-Content-Type-Options "nosniff"
				Referrer-Policy "same-origin"
			}
		}

		# Item images are anonymous in Jellyfin 12.2 too; require a valid token
		# (Authorization header or ApiKey= query) for them and any other media path.
		@media path_regexp media (?i)^/+items/[^/]+/images/
		forward_auth @media jellyfin:8096 {
			uri /Users/Me?{query}
		}

		reverse_proxy jellyfin:8096 {
			# Requests only arrive through the tunnel, so Cloudflare's header is the real
			# client IP. Jellyfin needs it for per-client login lockout and its logs.
			header_up X-Forwarded-For {http.request.header.Cf-Connecting-IP}
		}
	}
}
