# Copy to .env and fill in. .env is git-ignored — never commit it.

# Folder on this machine that holds the videos (mounted read-only)
MEDIA_DIR=/path/to/your/videos

# Run Jellyfin as your user so it can read MEDIA_DIR (`id -u` / `id -g`)
PUID=1001
PGID=1001

# From Cloudflare Zero Trust → Networks → Tunnels → (your tunnel) → install connector → token
CLOUDFLARE_TUNNEL_TOKEN=

# Jellyfin ItemId of the "Kodai 1994" library (GET /Library/VirtualFolders → ItemId).
# The gateway lets only users with access to this library fetch /kodai1994/hls/.
KODAI_LIBRARY_ID=

# Face identification models (InsightFace buffalo_l: det_10g.onnx + w600k_r50.onnx), for
# the faceid worker. See README.md → Identify faces.
FACEID_MODELS=/path/to/tools/faceid/models

# Nightly backup to a Google Drive folder (kodai1994/backup.sh). BACKUP_REMOTE is an
# rclone remote (`rclone config`) whose account can edit the folder; BACKUP_FOLDER_ID is
# the last part of the folder's URL; BACKUP_SOURCE holds the original videos and photos.
BACKUP_REMOTE=gdrive:
BACKUP_FOLDER_ID=
BACKUP_SOURCE=/path/to/originals
# Encrypts the backup of the stack itself (Jellyfin's accounts and password hashes, this
# file) before it goes to Drive. Long and random; keep a copy OFF this machine, or the
# archive can't be opened when you need it. Empty: the stack isn't backed up.
BACKUP_PASSPHRASE=

# Monitoring (kodai1994/monitor.py) emails problems to ADMIN_EMAIL with the SMTP settings
# below; NTFY_URL (e.g. https://ntfy.sh/<a-secret-topic>) also posts them to ntfy.
NTFY_URL=

# Captions worker: where the Whisper model is (default ~/services/yajur-videos/captions-models)
CAPTIONS_MODELS=

# Descriptions of recordings from their transcripts (kodai1994/describe.py). Setting it
# sends the transcripts (text, not sound) to Anthropic. Empty: nothing is sent.
ANTHROPIC_API_KEY=

# Jellyfin API key (Dashboard → API Keys, or POST /Auth/Keys as an administrator) so that
# moderators can approve access requests. Server-side only; treat it like a password.
JELLYFIN_API_KEY=

# Optional email for access requests. New requests email ADMIN_EMAIL; approving one emails
# the person their sign-in details. Leave SMTP_HOST empty to send nothing.
# Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<the Workspace address>,
# SMTP_PASSWORD=<an App Password for that account: myaccount.google.com/apppasswords>.
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
